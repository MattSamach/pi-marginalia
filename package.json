{
  "name": "pi-marginalia",
  "version": "0.2.0",
  "description": "Agent-guided browser reviews of Git changes and markdown plans for Pi, with live comment threads and iterative rounds",
  "type": "module",
  "keywords": [
    "pi-package",
    "code-review",
    "plan-review",
    "git-diff",
    "markdown"
  ],
  "author": "Matt Samach",
  "repository": {
    "type": "git",
    "url": "https://github.com/MattSamach/pi-marginalia"
  },
  "files": [
    "index.ts",
    "client",
    "shared",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node ./test/regressions.mjs && node ./test/margin-doc-rpc.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "puppeteer-core": "^25.9.0",
    "typebox": "^1.0.64",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "mermaid": "^11.17.2"
  }
}
